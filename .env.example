# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values. The same variables must also be set in the Vercel dashboard:
# Project → Settings → Environment Variables.

# --- Database (Supabase → Project Settings → API Keys) -----------------------
SUPABASE_URL=

# Secret key (sb_secret_…). Bypasses row-level security, so it is read only in
# server code and must NEVER be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard sign-in -------------------------------------------------------
# One account for the site owner. The password is never stored — only a scrypt
# hash of it. Generate one with:
#   node scripts/hash-password.mjs "the password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Any long random string; changing it signs everyone
# out. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
